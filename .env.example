# Copy to .env and fill in. Never commit .env.

# Neon Postgres connection string (pooled). https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/stocksense?sslmode=require"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Optional: Google login is enabled only when both are set
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# LLM parser (used from milestone 3)
LLM_PROVIDER="groq"
LLM_API_KEY=""
LLM_MODEL="llama-3.3-70b-versatile"
LLM_TIMEOUT_MS="10000"
